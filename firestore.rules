rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Health check endpoint for SDK connection validation
    match /test/{docId} {
      allow get: if true;
    }

    // Validation for User profile and budget settings
    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.monthlyBudget is number && data.monthlyBudget >= 0 && data.monthlyBudget <= 100000000 &&
             (!('customCategories' in data) || (data.customCategories is list && data.customCategories.size() <= 100)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
             (!('countryCode' in data) || (data.countryCode is string && data.countryCode.size() <= 16)) &&
             (!('countryName' in data) || (data.countryName is string && data.countryName.size() <= 64)) &&
             (!('currency' in data) || (data.currency is string && data.currency.size() <= 16)) &&
             (!('currencySymbol' in data) || (data.currencySymbol is string && data.currencySymbol.size() <= 16)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Validation for Transaction entries
    function isValidTransaction(data, userId) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId == userId &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 256 &&
             data.amount is number && data.amount > 0 && data.amount <= 100000000 &&
             (data.type == 'expense' || data.type == 'income') &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 64 &&
             data.date is string && data.date.size() <= 32 &&
             (!('merchant' in data) || (data.merchant is string && data.merchant.size() <= 128)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 1024)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // Users collection and subcollections
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().id == userId;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().id == existing().id;
      allow delete: if isOwner(userId) && isValidId(userId);

      // User transactions subcollection
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(transactionId) && isValidTransaction(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(transactionId) && isValidTransaction(incoming(), userId) && incoming().id == existing().id && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(transactionId);
      }
    }
  }
}
